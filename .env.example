# Skopiuj do .env.local i uzupełnij. Nie commituj .env.local.

# Adres projektu Supabase (lokalnie: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Klucz publiczny (publishable) Supabase — bezpieczny w przeglądarce
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Klucz tajny (secret) Supabase — tylko po stronie serwera, nigdy w przeglądarce
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile — domyślnie testowe klucze Cloudflare (lokalnie i w CI)
# Klucz witryny (publiczny)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Klucz tajny — sprawdzanie tokenu po stronie serwera
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Sekret do podpisu ciasteczka resetu hasła (HMAC) — wymagany, bez niego reset hasła nie działa.
# Wygeneruj własny: `openssl rand -base64 32` (PowerShell 7: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))).
# Każde środowisko (lokalne, produkcja) ma osobny; nigdy nie commituj prawdziwej wartości.
RECOVERY_COOKIE_SECRET=

# Publiczny adres aplikacji — z niego powstają linki w e-mailach i powroty z logowania Google.
# W produkcji wymagany (np. https://rhytm.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Powiadomienia push (Web Push, VAPID). Bez nich aplikacja działa, a Ustawienia → Powiadomienia
# pokazują „Push nie jest jeszcze skonfigurowany”. Skąd je wziąć: spec
# docs/superpowers/specs/2026-11-24-ustawienia-web-design.md, sekcja „Kroki Mejsona” (punkty 1–3).
# Klucze generujesz u siebie: `npx web-push generate-vapid-keys` (Public Key i Private Key).
# Klucz publiczny VAPID — trafia do przeglądarki (wchodzi do kodu przy budowaniu, po zmianie trzeba przebudować)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Klucz prywatny VAPID — tylko po stronie serwera, na Vercel jako „Sensitive”
VAPID_PRIVATE_KEY=
# Kontakt dla serwerów push: „mailto:” + Twój adres e-mail
VAPID_SUBJECT=
# Sekret, którym pg_cron (przez pg_net) podpisuje wywołania /api/cron/powiadomienia: `openssl rand -base64 32`.
# Ta sama wartość musi być w Supabase Vault jako rhytm_cron_secret (punkt 4 „Kroków Mejsona”)
CRON_SECRET=

# Tylko testy e2e (Playwright): sekret Supabase służy do zakładania kont testowych, a E2E_SUPABASE=1 włącza testy z logowaniem.
# Lokalnie: E2E_SUPABASE=1 pnpm test:e2e (wymaga `supabase start`)
E2E_SUPABASE=
